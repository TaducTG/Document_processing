# App Environment
APP_NAME="Enterprise Document Processing Platform"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doc_processor_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_processor_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage Configuration (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_REGION_NAME=us-east-1
S3_BUCKET_RAW=raw-documents
S3_BUCKET_PROCESSED=processed-output

# Worker Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

